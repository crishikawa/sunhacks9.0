# Local secrets. Copy to .env.local. Do not commit the copy.

# Live sentiment. Without this, scans use the labeled sample sequence.
XAI_API_KEY=

# Stored book. Without these, the book stays in server memory (local only).
NEXT_PUBLIC_SUPABASE_URL=
# Newer Supabase projects call this the publishable key; either name works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required in production. The desk page sends this on scan and reset.
DESK_ADMIN_SECRET=
