diff --git a/lib/demo.test.ts b/lib/demo.test.ts
new file mode 100644
index 0000000..b8312c8
--- /dev/null
+++ b/lib/demo.test.ts
@@ -0,0 +1,23 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { isDemoMode, xaiApiKey } from "./demo";
+import { deskEnv } from "./desk-secret";
+
+test("demo mode is off unless DEMO_MODE is true", () => {
+  assert.equal(isDemoMode({}), false);
+  assert.equal(isDemoMode({ DEMO_MODE: "false" }), false);
+  assert.equal(isDemoMode({ DEMO_MODE: "true" }), true);
+  assert.equal(isDemoMode({ DEMO_MODE: " TRUE " }), true);
+});
+
+test("demo mode hides the xAI key even when one is set", () => {
+  assert.equal(xaiApiKey({ XAI_API_KEY: "xai-live" }), "xai-live");
+  assert.equal(xaiApiKey({ XAI_API_KEY: "xai-live", DEMO_MODE: "true" }), undefined);
+  assert.equal(xaiApiKey({}), undefined);
+});
+
+test("demo mode lets production run without a desk secret", () => {
+  assert.equal(deskEnv({ VERCEL_ENV: "production" }).production, true);
+  assert.equal(deskEnv({ VERCEL_ENV: "production", DEMO_MODE: "true" }).production, false);
+  assert.equal(deskEnv({ DESK_ADMIN_SECRET: "s" }).secret, "s");
+});
diff --git a/lib/demo.ts b/lib/demo.ts
new file mode 100644
index 0000000..59a294f
--- /dev/null
+++ b/lib/demo.ts
@@ -0,0 +1,16 @@
+type Env = Record<string, string | undefined>;
+
+/**
+ * Public demo mode. With DEMO_MODE=true the app makes no paid or stateful calls:
+ * no xAI requests (sample sentiment and desk-data chat), no Supabase (the book lives
+ * in server memory), and the desk secret is optional. Safe to leave on a public URL.
+ */
+export function isDemoMode(env: Env = process.env): boolean {
+  return env.DEMO_MODE?.trim().toLowerCase() === "true";
+}
+
+/** The xAI key, or undefined in demo mode so no request can ever be billed. */
+export function xaiApiKey(env: Env = process.env): string | undefined {
+  if (isDemoMode(env)) return undefined;
+  return env.XAI_API_KEY || undefined;
+}
